@model LoginVm
@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header Banner -->
                <div class="bg-primary bg-gradient text-white text-center p-4">
                    <div class="mb-2">
                        <i class="bi bi-person-circle display-4"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Welcome Back</h2>
                    <p class="text-white-50 mb-0">Login to your account to continue</p>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4 p-sm-5 bg-white">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <input asp-for="ReturnUrl" type="hidden" />

                        <!-- Email -->
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control rounded-3" id="emailInput" placeholder="name@example.com" required />
                            <label for="emailInput"><i class="bi bi-envelope me-2"></i>Email Address</label>
                            <span asp-validation-for="Email" class="text-danger small ms-1"></span>
                        </div>

                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Password" type="password" class="form-control rounded-3" id="passwordInput" placeholder="Password" required />
                            <label for="passwordInput"><i class="bi bi-lock me-2"></i>Password</label>
                            <span asp-validation-for="Password" class="text-danger small ms-1"></span>
                        </div>

                        <!-- Forgot Password Link -->
                        <div class="text-end mb-4">
                            <a asp-action="ForgotPassword" class="text-decoration-none small text-muted hover-underline">Forgot Password?</a>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold py-3 shadow-sm hover-elevate">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                        </button>
                    </form>

                    <!-- Demo Credentials Info Box -->
                    <div class="alert alert-light border rounded-3 mt-4 mb-0 text-center text-muted small">
                        <i class="bi bi-info-circle-fill text-primary me-1"></i>
                        <strong>Demo:</strong> <code>customer@marketlink.local</code> / <code>Customer@123</code>
                    </div>
                </div>

                <!-- Footer Links -->
                <div class="card-footer bg-light border-0 text-center py-3">
                    <div class="d-flex justify-content-center gap-2 flex-wrap small">
                        <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Create customer account</a>
                        <span class="text-muted">•</span>
                        <a asp-action="FarmerRegister" class="text-success fw-bold text-decoration-none">Register as farmer</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-elevate {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-elevate:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(13, 110, 253, 0.25) !important;
        }

    .hover-underline:hover {
        text-decoration: underline !important;
    }
</style>