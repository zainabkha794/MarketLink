@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-50">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                <!-- Header Banner -->
                <div class="bg-warning bg-gradient text-dark p-4">
                    <div class="mb-2">
                        <i class="bi bi-shield-lock-fill display-4"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Password Help</h2>
                    <p class="text-dark-50 mb-0">Account Recovery Assistance</p>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-sm-5 bg-white">
                    <div class="alert alert-info rounded-3 mb-4 text-start border-0 shadow-sm" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <span>This demo keeps account recovery local. Contact the administrator to reset a demo account.</span>
                    </div>

                    <!-- Back to Login Button -->
                    <a class="btn btn-outline-dark btn-lg w-100 rounded-3 fw-semibold py-3 shadow-sm hover-elevate text-decoration-none" asp-action="Login">
                        <i class="bi bi-arrow-left me-2"></i>Back to Login
                    </a>
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light border-0 text-center py-3">
                    <span class="text-muted small">Need further help? Contact system support.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-elevate {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-elevate:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15) !important;
        }
</style>