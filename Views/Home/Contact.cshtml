@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5">
    <!-- Header Banner -->
    <div class="card border-0 bg-primary bg-gradient text-white rounded-4 overflow-hidden mb-5 shadow-sm">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="mb-3">
                <i class="bi bi-envelope-paper-heart-fill display-3 text-white-50"></i>
            </div>
            <h1 class="display-5 fw-bold mb-2">Get in Touch</h1>
            <p class="lead text-white-50 mx-auto mb-0" style="max-width: 600px;">
                Have questions or need assistance with your orders? We're here to help you connect seamlessly.
            </p>
        </div>
    </div>

    <!-- Contact Info Cards -->
    <div class="row g-4 justify-content-center">
        <!-- Email -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white text-center hover-elevate">
                <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-envelope-at-fill fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Email Us</h5>
                <p class="text-muted small mb-3">Drop us a line anytime for support or queries.</p>
                <a href="mailto:support@marketlink.local" class="text-primary fw-semibold text-decoration-none">
                    support@marketlink.local
                </a>
            </div>
        </div>

        <!-- Phone -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white text-center hover-elevate">
                <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-telephone-outbound-fill fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Call Us</h5>
                <p class="text-muted small mb-3">Available during standard business hours.</p>
                <a href="tel:+923000000000" class="text-success fw-semibold text-decoration-none">
                    +92 300 0000000
                </a>
            </div>
        </div>

        <!-- Location -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white text-center hover-elevate">
                <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-geo-alt-fill fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Location</h5>
                <p class="text-muted small mb-3">Our main operating hub and headquarters.</p>
                <span class="text-dark fw-semibold">
                    Karachi, Pakistan
                </span>
            </div>
        </div>
    </div>
</div>