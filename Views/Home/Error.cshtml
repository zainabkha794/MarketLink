@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-50">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                <!-- Header Banner -->
                <div class="bg-danger bg-gradient text-white p-4">
                    <div class="mb-2">
                        <i class="bi bi-exclamation-triangle-fill display-3"></i>
                    </div>
                    <h1 class="fw-bold mb-1 h2">Something Went Wrong</h1>
                    <p class="text-white-50 mb-0">An unexpected error occurred while processing your request.</p>
                </div>

                <!-- Body Content -->
                <div class="card-body p-4 p-sm-5 bg-white">
                    <p class="text-muted fs-5 mb-4">
                        Please return to the home page and try again.
                    </p>

                    <!-- Home Button -->
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-3 fw-semibold px-4 py-3 shadow-sm hover-elevate text-decoration-none d-inline-flex align-items-center gap-2">
                        <i class="bi bi-house-door-fill"></i> Return to Home
                    </a>

                    @if (Model.ShowRequestId)
                    {
                        <div class="mt-4 pt-3 border-top">
                            <span class="text-muted small">Technical Tracking Info:</span>
                            <div class="mt-1">
                                <code class="bg-light text-danger px-3 py-1 rounded-2 border d-inline-block small">
                                    Request ID: @Model.RequestId
                                </code>
                            </div>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light border-0 text-center py-3">
                    <span class="text-muted small">If the issue persists, please contact MarketLink support.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-elevate {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-elevate:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(220, 53, 69, 0.2) !important;
        }
</style>