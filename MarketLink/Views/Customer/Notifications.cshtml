@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<header class="page-hero">
    <div class="container">
        <div class="breadcrumb"><a asp-controller="Customer" asp-action="Dashboard">Dashboard</a> <span>›</span> <span>Notifications</span></div>
        <h1>Your market inbox</h1>
        <p>Order updates, restock alerts and announcements.</p>
    </div>
</header>

<section class="section-tight">
    <div class="container-narrow">
        <div class="d-flex justify-between align-center mb-3">
            <div class="muted">@Model.Count(n => !n.IsRead) unread of @Model.Count</div>
            <form asp-action="MarkNotificationsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost btn-sm">Mark all as read</button>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-art">🔔</div>
                <h3>All quiet</h3>
                <p class="muted">Alerts about your orders and favourite produce will appear here.</p>
            </div>
        }
        else
        {
            <div class="card card-pad reveal">
                @foreach (var n in Model)
                {
                    <div class="d-flex gap-2" style="padding:15px 0; border-bottom:1px dashed rgba(27,67,50,.13); @(n.IsRead ? "" : "background: rgba(216,243,220,.25); margin: 0 -12px; padding-inline: 12px; border-radius: 10px;")">
                        <div class="mi-icon" style="width:42px;height:42px;flex-basis:42px;">
                            @(n.Type == "Order" ? "📦" : n.Type == "Restock" ? "🌿" : n.Type == "Review" ? "★" : "📣")
                        </div>
                        <div style="flex:1;">
                            <div class="d-flex justify-between">
                                <strong style="color: var(--forest-800);">@n.Title</strong>
                                <span class="muted" style="font-size:.78rem;">@n.CreatedAt.ToString("d MMM, HH:mm")</span>
                            </div>
                            <div class="muted" style="font-size:.92rem;">@n.Message</div>
                            @if (!string.IsNullOrEmpty(n.LinkUrl))
                            {
                                <a href="@n.LinkUrl" style="font-size:.85rem; font-weight:600;">View details →</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
