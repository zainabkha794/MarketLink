@model ProductFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add produce" : "Edit produce";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<header class="page-hero">
    <div class="container">
        <div class="breadcrumb">
            <a asp-action="Products">My produce</a> <span>›</span> <span>@(Model.Id == 0 ? "New listing" : "Edit listing")</span>
        </div>
        <h1>@(Model.Id == 0 ? "List new produce" : "Update your listing")</h1>
        <p>Customers see live stock — keep quantities honest and they will keep coming back.</p>
    </div>
</header>

<section class="section-tight">
    <div class="container-narrow">
        <div class="form-card reveal">
            <form asp-action="SaveProduct" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="Name"></label>
                    <input class="form-control" asp-for="Name" placeholder="e.g. Heritage Vine Tomatoes" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Description"></label>
                    <textarea class="form-control" asp-for="Description" rows="3" placeholder="What makes this special? Flavour, variety, how it was grown…"></textarea>
                </div>

                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label" asp-for="Price"></label>
                        <input class="form-control" asp-for="Price" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Price" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Unit"></label>
                        <select class="form-select" asp-for="Unit">
                            <option value="kg">kg</option>
                            <option value="gram">gram</option>
                            <option value="dozen">dozen</option>
                            <option value="liter">liter</option>
                            <option value="bunch">bunch</option>
                            <option value="box">box</option>
                            <option value="jar">jar</option>
                            <option value="loaf">loaf</option>
                            <option value="piece">piece</option>
                            <option value="pot">pot</option>
                            <option value="block">block</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="StockQuantity"></label>
                        <input class="form-control" asp-for="StockQuantity" type="number" min="0" />
                        <span asp-validation-for="StockQuantity" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" asp-for="CategoryId"></label>
                        <select class="form-select" asp-for="CategoryId">
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="ImageUrl"></label>
                        <input class="form-control" asp-for="ImageUrl" placeholder="https://… (photo of the produce)" />
                    </div>
                </div>

                <div class="ornament">❦</div>

                <h3>Availability &amp; weekly template</h3>
                <div class="form-group">
                    <label class="form-check"><input asp-for="IsAvailable" /> Available for pre-orders</label>
                </div>
                <div class="form-group">
                    <label class="form-check"><input asp-for="IsSoldOut" /> Mark as sold out (hidden from new orders)</label>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-check"><input asp-for="IsRecurringWeekly" /> Repeat this stock every week</label>
                        <p class="form-text">When enabled, “Reset weekly stock” restores the default quantity each market week.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="DefaultWeeklyQuantity"></label>
                        <input class="form-control" asp-for="DefaultWeeklyQuantity" type="number" min="0" />
                    </div>
                </div>

                <button type="submit" class="btn btn-gold btn-lg">@(Model.Id == 0 ? "Publish listing" : "Save changes")</button>
                <a class="btn btn-ghost" asp-action="Products">Back to my produce</a>
            </form>
        </div>
    </div>
</section>
