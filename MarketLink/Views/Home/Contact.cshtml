@{
    ViewData["Title"] = "Contact";
    var markets = ViewBag.Markets as List<Market> ?? new List<Market>();
}

<header class="page-hero">
    <div class="container">
        <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> <span>›</span> <span>Contact</span></div>
        <h1>Visit the market office</h1>
        <p>Questions about a stall, an order, or the platform? We are here.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        <div class="grid grid-2" style="gap:40px; align-items:start;">
            <div class="card card-pad reveal">
                <div class="section-kicker">Get in touch</div>
                <h2 style="font-size:1.75rem;">Send us a note</h2>
                <div class="meta-list">
                    <div class="meta-item">
                        <div class="mi-icon">✉</div>
                        <div><div class="mi-label">Email</div><a href="mailto:hello@marketlink.local">hello@marketlink.local</a></div>
                    </div>
                    <div class="meta-item">
                        <div class="mi-icon">☎</div>
                        <div><div class="mi-label">Telephone</div><a href="tel:+9221111000111">+92 21 111 000 111</a></div>
                    </div>
                    <div class="meta-item">
                        <div class="mi-icon">🏛</div>
                        <div><div class="mi-label">Office</div>Clifton Park, Block 5, Clifton, Karachi, Sindh</div>
                    </div>
                    <div class="meta-item">
                        <div class="mi-icon">🕰</div>
                        <div><div class="mi-label">Office hours</div>Monday – Friday, 9:00 – 17:00</div>
                    </div>
                </div>
                <div class="mt-3">
                    <a class="btn btn-gold" href="mailto:hello@marketlink.local">Write to us</a>
                </div>
            </div>

            <div class="reveal">
                <div class="map-frame" style="height:420px;">
                    <div class="map-fallback">
                        <div>
                            <div style="font-size:2.4rem;">📍</div>
                            <strong>Clifton Green Farmers Market</strong><br />
                            Clifton Park, Block 5, Karachi
                        </div>
                    </div>
                    <div id="contactMap" style="height:420px;"></div>
                </div>
                <div class="mt-2 muted" style="font-size:.88rem;">
                    Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var markets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(markets.Select(m => new { lat = m.Latitude, lng = m.Longitude, title = m.Name, subtitle = m.Address })));
            if (window.initMap) window.initMap("contactMap", markets, 11);
        })();
    </script>
}
