@{
    ViewData["Title"] = "Privacy";
}

<header class="page-hero">
    <div class="container">
        <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> <span>›</span> <span>Privacy</span></div>
        <h1>Privacy &amp; terms</h1>
        <p>How MarketLink handles your information.</p>
    </div>
</header>

<section class="section">
    <div class="container-narrow reveal">
        <h2>Your data, kept simple</h2>
        <p class="muted">MarketLink stores only the information needed to run the marketplace: your name, contact details, delivery-free pickup address, order history and reviews. We never sell personal data to third parties.</p>
        <h3 class="mt-3">Accounts</h3>
        <p class="muted">Passwords are stored as salted PBKDF2 hashes — never in plain text. Farmers are verified by administrators before their stalls appear publicly. Accounts can be deactivated by administrators in case of policy violations.</p>
        <h3 class="mt-3">Orders</h3>
        <p class="muted">Pre-orders are settled in person at pickup. MarketLink does not process payments and does not store card or bank details.</p>
        <h3 class="mt-3">Cookies</h3>
        <p class="muted">We use essential cookies for sign-in sessions and your shopping basket, and nothing more.</p>
        <h3 class="mt-3">Content</h3>
        <p class="muted">Product listings and reviews are moderated by the platform office. Inappropriate content can be hidden or removed at any time.</p>
    </div>
</section>
