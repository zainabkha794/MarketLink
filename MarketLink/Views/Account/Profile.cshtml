@model ProfileViewModel
@{
    ViewData["Title"] = "Account settings";
    var markets = ViewBag.Markets as List<Market> ?? new List<Market>();
    var currentIds = ViewBag.CurrentMarketIds as List<int> ?? new List<int>();
    var isFarmer = User.IsInRole("Farmer");
}

<header class="page-hero">
    <div class="container">
        <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> <span>›</span> <span>Account settings</span></div>
        <h1>Account settings</h1>
        <p>Keep your details fresh — just like the produce.</p>
    </div>
</header>

<section class="section">
    <div class="container-narrow">
        <div class="form-card reveal">
            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" asp-for="FullName"></label>
                        <input class="form-control" asp-for="FullName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Phone"></label>
                        <input class="form-control" asp-for="Phone" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Address"></label>
                    <input class="form-control" asp-for="Address" />
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="ProfileImageUrl"></label>
                    <input class="form-control" asp-for="ProfileImageUrl" placeholder="https://… (optional portrait)" />
                </div>

                @if (isFarmer)
                {
                    <div class="ornament">❦</div>
                    <h3>Stall profile</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" asp-for="StallName"></label>
                            <input class="form-control" asp-for="StallName" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="OrderCutoffHours"></label>
                            <input class="form-control" asp-for="OrderCutoffHours" type="number" min="1" max="72" />
                            <p class="form-text">Customers cannot modify orders after this cut-off.</p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Bio"></label>
                        <textarea class="form-control" asp-for="Bio" rows="4"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" asp-for="Latitude"></label>
                            <input class="form-control" asp-for="Latitude" step="0.000001" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Longitude"></label>
                            <input class="form-control" asp-for="Longitude" step="0.000001" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Markets you sell at</label>
                        <div class="grid grid-2 gap-1">
                            @foreach (var m in markets)
                            {
                                <label class="form-check">
                                    <input type="checkbox" name="MarketIds" value="@m.Id" checked="@(currentIds.Contains(m.Id))" /> @m.Name
                                </label>
                            }
                        </div>
                    </div>
                }

                <button type="submit" class="btn btn-gold">Save changes</button>
                <a class="btn btn-ghost" asp-controller="Farmer" asp-action="Dashboard">Back</a>
            </form>
        </div>

        <div class="form-card mt-3 reveal">
            <h3>Change password</h3>
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">Current password</label>
                        <input class="form-control" name="currentPassword" type="password" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">New password</label>
                        <input class="form-control" name="newPassword" type="password" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Confirm new password</label>
                        <input class="form-control" name="confirmPassword" type="password" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-forest">Change password</button>
            </form>
        </div>
    </div>
</section>
